# Версии образов
PYTHON_VERSION=3.12
POSTGRES_VERSION=17-alpine

# База данных
POSTGRES_USER=plis
POSTGRES_PASSWORD=change_me
POSTGRES_DB=plis
# Порт PostgreSQL внутри Docker и на localhost сервера
POSTGRES_PORT=5432
DB_HEALTHCHECK_INTERVAL=5s
DB_HEALTHCHECK_TIMEOUT=3s
DB_HEALTHCHECK_RETRIES=10

# Backend
# Адрес, который uvicorn слушает внутри контейнера
APP_HOST=0.0.0.0
# Порт uvicorn внутри контейнера
APP_PORT=8000
# Порт сайта на компьютере
WEB_PORT=8000

# Адрес компьютера с платой, доступный из контейнера backend.
BOARD_AGENT_URL=
# Скопируйте сюда AGENT_TOKEN с компьютера с платой.
BOARD_AGENT_TOKEN=

# Опрос доступности компьютера и платы через GET /check.
BOARD_HEALTH_INTERVAL=30
BOARD_HEALTH_FAILURE_LIMIT=3
