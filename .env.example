# Версии образов
PYTHON_VERSION=3.12
POSTGRES_VERSION=17-alpine

# База данных
POSTGRES_USER=plis
POSTGRES_PASSWORD=change_me
POSTGRES_DB=plis
# Порт внутри сети Docker, на компьютере он не открыт
POSTGRES_PORT=5432
DB_HEALTHCHECK_INTERVAL=5s
DB_HEALTHCHECK_TIMEOUT=3s
DB_HEALTHCHECK_RETRIES=10

# Backend
# Адрес, который uvicorn слушает внутри контейнера
APP_HOST=0.0.0.0
# Порт uvicorn внутри контейнера
APP_PORT=8000
# Порт сайта на компьютере
WEB_PORT=8000
